@model BloodBankSystem.Models.Patient
@{
    ViewData["Title"] = "Patient Profile";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Patient Profile</h1>
        <p class="page-subtitle">Update hospital location and emergency contact info</p>
    </div>
</div>

<div class="form-card">
    <form asp-action="Profile" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 1rem;"></div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Full Name:</label>
                <input class="form-control" value="@Model.User.FullName" disabled style="background-color: #E9ECEF;" />
            </div>

            <div class="form-group">
                <label class="form-label">Email Address:</label>
                <input class="form-control" value="@Model.User.Email" disabled style="background-color: #E9ECEF;" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Blood Group:</label>
                <select name="bloodGroupId" asp-items="@ViewBag.BloodGroupList" class="form-select" required>
                    <option value="@Model.BloodGroupId" selected>@Model.BloodGroup?.Name</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Hospital / Clinic Name:</label>
                <input name="hospitalName" value="@Model.HospitalName" class="form-control" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Contact Phone:</label>
                <input name="phone" value="@Model.User.Phone" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="form-label">City:</label>
                <input name="city" value="@Model.User.City" class="form-control" required />
            </div>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
            <button type="submit" class="btn btn-primary" style="flex: 1;">Save Profile Changes</button>
            <a asp-action="Dashboard" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
