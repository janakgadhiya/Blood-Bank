@model IEnumerable<BloodBankSystem.Models.BloodRequest>
@{
    ViewData["Title"] = "My Blood Requests";
}

<div class="page-header">
    <div>
        <h1 class="page-title">My Blood Requests</h1>
        <p class="page-subtitle">Track status and review responses from the blood bank</p>
    </div>
    <div>
        <a asp-action="NewRequest" class="btn btn-primary">+ New Blood Request</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Request ID</th>
                <th>Blood Group</th>
                <th>Units</th>
                <th>Required By</th>
                <th>Status</th>
                <th>Admin Remarks</th>
                <th>Submitted On</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                        You have not submitted any blood requests yet. <a asp-action="NewRequest">Create your first request</a>.
                    </td>
                </tr>
            }
            @foreach (var req in Model)
            {
                <tr>
                    <td><code>#@req.Id</code></td>
                    <td><strong style="color: var(--primary-color);">@req.BloodGroup?.Name</strong></td>
                    <td><strong>@req.UnitsRequired</strong></td>
                    <td>@req.RequiredByDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @switch (req.Status)
                        {
                            case BloodBankSystem.Models.RequestStatus.Pending:
                                <span class="badge badge-pending">Pending</span>
                                break;
                            case BloodBankSystem.Models.RequestStatus.Approved:
                                <span class="badge badge-approved">Approved</span>
                                break;
                            case BloodBankSystem.Models.RequestStatus.Issued:
                                <span class="badge badge-issued">Issued</span>
                                break;
                            case BloodBankSystem.Models.RequestStatus.Rejected:
                                <span class="badge badge-rejected">Rejected</span>
                                break;
                            case BloodBankSystem.Models.RequestStatus.Cancelled:
                                <span class="badge badge-cancelled">Cancelled</span>
                                break;
                        }
                    </td>
                    <td style="font-size: 0.85rem; color: var(--text-muted); max-width: 250px;">
                        @(string.IsNullOrEmpty(req.AdminRemarks) ? "-" : req.AdminRemarks)
                    </td>
                    <td style="font-size: 0.82rem; color: var(--text-muted);">
                        @req.CreatedAt.ToLocalTime().ToString("g")
                    </td>
                    <td>
                        @if (req.Status == BloodBankSystem.Models.RequestStatus.Pending)
                        {
                            <form asp-action="Cancel" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to cancel request #@req.Id?');">
                                <input type="hidden" name="id" value="@req.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                            </form>
                        }
                        else
                        {
                            <span style="font-size: 0.8rem; color: var(--text-muted);">Completed</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
