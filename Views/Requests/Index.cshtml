@model IEnumerable<BloodBankSystem.Models.BloodRequest>
@{
    ViewData["Title"] = "Blood Requests";
    var stockMap = ViewBag.StockMap as Dictionary<int, int> ?? new();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Blood Requests</h1>
        <p class="page-subtitle">Manage patient blood requests and track fulfillment status</p>
    </div>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Req ID</th>
                <th>Group</th>
                <th>Units</th>
                <th>In Stock</th>
                <th>Patient / Hospital</th>
                <th>Required By</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                        No blood requests found.
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                var availableInStock = stockMap.ContainsKey(item.BloodGroupId) ? stockMap[item.BloodGroupId] : 0;

                <tr>
                    <td><code>#@item.Id</code></td>
                    <td><strong style="color: var(--primary-color); font-size: 1.05rem;">@item.BloodGroup?.Name</strong></td>
                    <td><strong>@item.UnitsRequired</strong></td>
                    <td>
                        <span style="font-weight: 600; color: @(availableInStock >= item.UnitsRequired ? "#2E7D32" : "#C62828");">
                            @availableInStock units
                        </span>
                    </td>
                    <td>
                        <strong>@(item.Patient?.User?.FullName ?? "Unknown")</strong><br />
                        <span style="font-size: 0.8rem; color: var(--text-muted);">@(item.Patient?.HospitalName ?? "N/A")</span>
                    </td>
                    <td style="font-size: 0.85rem;">@item.RequiredByDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @switch (item.Status)
                        {
                            case BloodBankSystem.Models.RequestStatus.Pending:
                                <span class="badge badge-pending">Pending</span>
                                break;
                            case BloodBankSystem.Models.RequestStatus.Approved:
                                <span class="badge badge-approved">Approved</span>
                                break;
                            case BloodBankSystem.Models.RequestStatus.Issued:
                                <span class="badge badge-issued">Issued</span>
                                break;
                            case BloodBankSystem.Models.RequestStatus.Rejected:
                                <span class="badge badge-rejected">Rejected</span>
                                break;
                            case BloodBankSystem.Models.RequestStatus.Cancelled:
                                <span class="badge badge-cancelled">Cancelled</span>
                                break;
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline">Review Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
