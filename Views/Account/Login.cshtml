@model BloodBankSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="form-card" style="max-width: 450px;">
    <div style="text-align: center; margin-bottom: 1.5rem;">
        <h2 class="page-title">Sign In</h2>
        <p class="page-subtitle">Access your BloodBank portal</p>
    </div>

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 1rem;"></div>

        <div class="form-group">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="admin@bloodbank.com" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" placeholder="••••••••" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem;">
            <input asp-for="RememberMe" id="rememberMe" />
            <label for="rememberMe" style="font-size: 0.9rem; cursor: pointer;">Remember me on this device</label>
        </div>

        <div style="margin-top: 1.5rem;">
            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.75rem;">Log In</button>
        </div>
    </form>

    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; border-top: 1px solid var(--border-color); padding-top: 1rem;">
        Don't have an account? <a asp-action="Register" style="color: var(--primary-color); font-weight: 600;">Register here</a>
    </div>

    <div style="background-color: #F8F9FA; border: 1px dashed var(--border-color); border-radius: var(--border-radius); padding: 0.75rem; margin-top: 1.25rem; font-size: 0.82rem; color: var(--text-muted);">
        <strong>Demo Admin Credentials:</strong><br/>
        Email: <code>admin@bloodbank.com</code><br/>
        Password: <code>Admin@123</code>
    </div>
</div>
