<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Blood Bank Management System</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar">
            <a class="nav-brand" asp-controller="Home" asp-action="Index">
                🩸 BloodBank
            </a>

            <ul class="nav-links">
                @if (User.IsInRole("Admin"))
                {
                    <li><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li><a class="nav-link" asp-controller="Donors" asp-action="Index">Donors</a></li>
                    <li><a class="nav-link" asp-controller="Patients" asp-action="Index">Patients</a></li>
                    <li><a class="nav-link" asp-controller="Stock" asp-action="Index">Stock</a></li>
                    <li><a class="nav-link" asp-controller="Donations" asp-action="Index">Donations</a></li>
                    <li><a class="nav-link" asp-controller="Requests" asp-action="Index">Requests</a></li>
                    <li><a class="nav-link" asp-controller="Transactions" asp-action="Index">Transactions</a></li>
                }
                else if (User.IsInRole("Donor"))
                {
                    <li><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a class="nav-link" asp-controller="BloodSearch" asp-action="Index">Search Blood</a></li>
                    <li><a class="nav-link" asp-controller="Donor" asp-action="Dashboard">Dashboard</a></li>
                    <li><a class="nav-link" asp-controller="Donor" asp-action="MyDonations">My Donations</a></li>
                    <li><a class="nav-link" asp-controller="Donor" asp-action="Profile">Profile</a></li>
                }
                else if (User.IsInRole("Patient"))
                {
                    <li><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a class="nav-link" asp-controller="BloodSearch" asp-action="Index">Search Blood</a></li>
                    <li><a class="nav-link" asp-controller="Patient" asp-action="Dashboard">Dashboard</a></li>
                    <li><a class="nav-link" asp-controller="Patient" asp-action="NewRequest">New Request</a></li>
                    <li><a class="nav-link" asp-controller="Patient" asp-action="MyRequests">My Requests</a></li>
                    <li><a class="nav-link" asp-controller="Patient" asp-action="Profile">Profile</a></li>
                }
                else
                {
                    <li><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a class="nav-link" asp-controller="BloodSearch" asp-action="Index">Search Blood</a></li>
                    <li><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                    <li><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                }
            </ul>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="nav-user">
                    <span>@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                        <button type="submit" class="btn-logout">Logout</button>
                    </form>
                </div>
            }
        </nav>
    </header>

    <main class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <span>✓ @TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <span>⚠ @TempData["Error"]</span>
            </div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning">
                <span>⚠ @TempData["Warning"]</span>
            </div>
        }

        @RenderBody()
    </main>

    <footer>
        <div class="container" style="margin:0 auto; padding: 0.5rem 1rem;">
            &copy; 2026 Blood Bank Management System. All rights reserved.
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
