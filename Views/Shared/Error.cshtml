@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="form-card" style="text-align: center; max-width: 500px; padding: 2.5rem 1.5rem;">
    <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
    <h2 class="page-title" style="color: #C62828;">Something went wrong</h2>
    <p style="color: var(--text-muted); margin: 1rem 0 1.5rem 0;">
        An unexpected error occurred while processing your request. Please try again or return to the home page.
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return Home</a>
</div>
