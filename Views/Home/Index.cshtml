@model IEnumerable<BloodBankSystem.ViewModels.StockItemViewModel>
@{
    ViewData["Title"] = "Home - Real-time Blood Availability";
}

<!-- Hero Section -->
<div class="card card-primary" style="text-align: center; padding: 2.25rem 1.5rem; margin-bottom: 2rem;">
    <h1 class="page-title" style="font-size: 2.2rem; margin-bottom: 0.5rem;">Save Lives, Donate Blood</h1>
    <p class="page-subtitle" style="font-size: 1.05rem; max-width: 650px; margin: 0 auto 1.5rem auto;">
        Connecting blood donors with patients in real-time. Check live blood group availability below or register today.
    </p>

    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a asp-controller="BloodSearch" asp-action="Index" class="btn btn-primary">Search Available Blood</a>
        @if (!User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-secondary">Become a Donor</a>
        }
    </div>
</div>

<div class="page-header" style="margin-bottom: 1.25rem;">
    <div>
        <h2 class="page-title" style="font-size: 1.35rem;">Live Blood Group Stock Levels</h2>
        <p class="page-subtitle">Real-time inventory verified directly against the hospital blood bank</p>
    </div>
</div>

<!-- Blood Group Cards Grid -->
<div class="card-grid">
    @foreach (var group in Model)
    {
        <div class="card @(group.AvailableUnits == 0 ? "card-danger" : (group.Status == "Low" ? "card-warning" : "card-success"))" style="text-align: center;">
            <div class="card-title">Blood Group</div>
            <div style="font-size: 2.2rem; font-weight: 800; color: var(--primary-color); margin-bottom: 0.25rem;">
                @group.BloodGroupName
            </div>
            <div class="card-value" style="font-size: 1.6rem; color: @(group.AvailableUnits == 0 ? "#C62828" : (group.Status == "Low" ? "#E65100" : "#2E7D32"))">
                @group.AvailableUnits <span style="font-size: 0.95rem; font-weight: normal; color: var(--text-muted);">units</span>
            </div>
            <div style="margin-top: 0.5rem;">
                <span class="badge @group.StatusClass">@group.Status</span>
            </div>
        </div>
    }
</div>
